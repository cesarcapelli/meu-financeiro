{
  "entities": {
    "User": {
      "title": "User Settings",
      "description": "User preferences and current viewing state",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string"
        },
        "currentMonth": {
          "type": "string"
        },
        "hideBalances": {
          "type": "boolean"
        }
      },
      "required": [
        "uid"
      ]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial transactions",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "desc": {
          "type": "string"
        },
        "cat": {
          "type": "string"
        },
        "month": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "type": {
          "type": "string",
          "enum": [
            "in",
            "out"
          ]
        },
        "bucket": {
          "type": "string",
          "enum": [
            "fixo",
            "variavel"
          ]
        },
        "card": {
          "type": "string"
        },
        "isSplit": {
          "type": "boolean"
        },
        "splitPercent": {
          "type": "number"
        },
        "splitWith": {
          "type": "string"
        },
        "originalValue": {
          "type": "number"
        },
        "userId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "desc",
        "cat",
        "month",
        "date",
        "value",
        "type",
        "bucket"
      ]
    },
    "Card": {
      "title": "Credit Card",
      "description": "Registered credit cards",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "bank": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "limit": {
          "type": "number"
        },
        "current": {
          "type": "number"
        },
        "closing": {
          "type": "string"
        },
        "due": {
          "type": "string"
        },
        "bestDay": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "bank",
        "color",
        "limit",
        "current",
        "closing",
        "due",
        "bestDay"
      ]
    },
    "Budget": {
      "title": "Budget Limit",
      "description": "Monthly budget limits by category",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "cat": {
          "type": "string"
        },
        "limite": {
          "type": "number"
        },
        "iconName": {
          "type": "string"
        },
        "cor": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "cat",
        "limite",
        "iconName",
        "cor"
      ]
    },
    "Goal": {
      "title": "Financial Goal",
      "description": "Saving goals with current accumulated values",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "atual": {
          "type": "number"
        },
        "total": {
          "type": "number"
        },
        "cor": {
          "type": "string"
        },
        "deadline": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "atual",
        "total",
        "cor",
        "deadline"
      ]
    },
    "CategoryRule": {
      "title": "Category Rule",
      "description": "Rules for auto-categorization of import keywords",
      "type": "object",
      "properties": {
        "keyword": {
          "type": "string"
        },
        "cat": {
          "type": "string"
        },
        "bucket": {
          "type": "string",
          "enum": [
            "fixo",
            "variavel"
          ]
        },
        "userId": {
          "type": "string"
        }
      },
      "required": [
        "keyword",
        "cat",
        "bucket"
      ]
    },
    "CardBill": {
      "title": "Card Bill",
      "description": "Monthly credit card bills",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "cardId": {
          "type": "string"
        },
        "month": {
          "type": "string"
        },
        "dueDate": {
          "type": "string"
        },
        "totalValue": {
          "type": "number"
        },
        "isPaid": {
          "type": "boolean"
        },
        "fileName": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "cardId",
        "month",
        "dueDate",
        "totalValue",
        "isPaid"
      ]
    },
    "House": {
      "title": "House",
      "description": "Collaborative house with members",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "photoUrl": {
          "type": "string"
        },
        "memberEmails": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ownerId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "memberEmails",
        "ownerId"
      ]
    },
    "HouseTransaction": {
      "title": "House Transaction",
      "description": "Financial transactions belonging to a house",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "desc": {
          "type": "string"
        },
        "cat": {
          "type": "string"
        },
        "month": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "type": {
          "type": "string",
          "enum": [
            "in",
            "out"
          ]
        },
        "bucket": {
          "type": "string",
          "enum": [
            "fixo",
            "variavel"
          ]
        },
        "card": {
          "type": "string"
        },
        "isSplit": {
          "type": "boolean"
        },
        "splitPercent": {
          "type": "number"
        },
        "splitWith": {
          "type": "string"
        },
        "originalValue": {
          "type": "number"
        },
        "houseId": {
          "type": "string"
        },
        "addedBy": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "desc",
        "cat",
        "month",
        "date",
        "value",
        "type",
        "bucket",
        "houseId",
        "addedBy"
      ]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Main user settings and metadata document"
    },
    "users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "List of user transactions"
    },
    "users/{userId}/cards/{cardId}": {
      "schema": "Card",
      "description": "List of user credit cards"
    },
    "users/{userId}/budgets/{budgetId}": {
      "schema": "Budget",
      "description": "List of user budgets"
    },
    "users/{userId}/goals/{goalId}": {
      "schema": "Goal",
      "description": "List of user saving goals"
    },
    "users/{userId}/rules/{ruleId}": {
      "schema": "CategoryRule",
      "description": "List of user transaction categorization rules"
    },
    "users/{userId}/faturas/{faturaId}": {
      "schema": "CardBill",
      "description": "List of user credit card bills"
    },
    "houses/{houseId}": {
      "schema": "House",
      "description": "Collaborative houses"
    },
    "houses/{houseId}/transactions/{transactionId}": {
      "schema": "HouseTransaction",
      "description": "Transactions belonging to a house"
    }
  }
}